[Unit]
Description=Build qwen3.8-27b image for ROCm Strix Halo
Documentation=https://github.com/nicholasburr/llamacpp-qwen3.8-27b
After=network-online.target
Wants=network-online.target

[Build]
ImageTag=localhost/qwen3.8-27b:v0.4.1-rocm-10.0.0
File=containers/Containerfile.qwen3.8-27b
SetWorkingDirectory=/home/nburr/Desktop/fedora/llamacpp-qwen3.8-27b
ForceRM=true
# Build args for containers/Containerfile.qwen3.8-27b (same defaults as its
# ARG lines; kept here so the build is explicit). `make sync` keeps ImageTag
# and these BuildArg lines in lockstep with TAGS. The GPU target (gfx1151) is
# hardcoded in the Containerfile — it is not a build arg.
BuildArg=FEDORA_VERSION=44
BuildArg=ROCM_VERSION=10.0.0
BuildArg=TAG=v0.4.1

[Service]
Type=simple
RemainAfterExit=yes

[Install]
WantedBy=default.target

