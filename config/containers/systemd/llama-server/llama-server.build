[Unit]
Description=Build llama-server image for ROCm Strix Halo
Documentation=https://github.com/nicholasburr/fedora-llamacpp
After=network-online.target
Wants=network-online.target

[Build]
ImageTag=localhost/llama-server:b10902-rocm-10.0.0
File=containers/Containerfile.llama-server
SetWorkingDirectory=/home/nburr/Desktop/fedora/fedora-llamacpp
ForceRM=true
# Build args for containers/Containerfile.llama-server (same defaults as its
# ARG lines; kept here so the build is explicit). `make sync` keeps ImageTag
# and these BuildArg lines in lockstep with TAGS.
BuildArg=FEDORA_VERSION=44
BuildArg=ROCM_VERSION=10.0.0
BuildArg=GPU_TARGET=gfx1151
BuildArg=BRANCH=df03399b885831b2a1603b3abb0d8c156808e363

[Service]
Type=simple
RemainAfterExit=yes

[Install]
WantedBy=default.target

