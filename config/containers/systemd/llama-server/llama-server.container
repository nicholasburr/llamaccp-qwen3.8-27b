[Unit]
Description=Llama Server (ROCm 10.0.0)
Wants=llama-server-build.service
After=network-online.target

[Container]
ContainerName=llama-server
Image=localhost/llama-server:b10902-rocm-10.0.0
Network=llama-network
PublishPort=8000:8000
AddDevice=/dev/dri
AddDevice=/dev/kfd
GroupAdd=video
GroupAdd=render
PodmanArgs=--ipc=host
SeccompProfile=unconfined
Secret=huggingface-token,type=env,target=HF_TOKEN
Volume=/home/nburr/.cache/huggingface/hub/:/root/.cache/huggingface/hub/:Z
Volume=/home/nburr/.config/llama.cpp/:/root/.config/llama.cpp/:Z
# Model selection (resolved from the mounted HF cache)
Environment=LLAMA_ARG_HF_REPO=unsloth/Qwen3.8-27B-GGUF:UD-Q4_K_XL
Environment=LLAMA_ARG_ALIAS=Qwen3.8-27B-ThinkingCoder
# Server
Environment=LLAMA_ARG_LOG_TIMESTAMPS=on
Environment=LLAMA_ARG_HOST=0.0.0.0
Environment=LLAMA_ARG_PORT=8000
# Runtime — tuned (README §2)
Environment=LLAMA_ARG_THREADS=8
# b10884 has no LLAMA_ARG_MMAP env var; LOAD_MODE=auto keeps the measured
# mmap behavior (values: auto/none/mmap/mlock/mmap+mlock/dio)
Environment=LLAMA_ARG_LOAD_MODE=auto
Environment=LLAMA_ARG_FIT=off
Environment=LLAMA_ARG_N_GPU_LAYERS=99
Environment=LLAMA_ARG_CTX_SIZE=262144
Environment=LLAMA_ARG_FLASH_ATTN=on
Environment=LLAMA_ARG_N_PARALLEL=1
Environment=LLAMA_ARG_CONT_BATCHING=on
# Self-speculative decoding via the model's built-in MTP head (blk.64.nextn);
# check acceptance in the server /metrics
Environment=LLAMA_ARG_SPEC_TYPE=draft-mtp
Environment=LLAMA_ARG_CACHE_TYPE_K=q8_0
Environment=LLAMA_ARG_CACHE_TYPE_V=q8_0
# Features (--agent implies --tools all + MCP proxy; kept explicit)
Environment=LLAMA_ARG_UI=on
Environment=LLAMA_ARG_UI_MCP_PROXY=on
Environment=LLAMA_ARG_AGENT=on
Environment=LLAMA_ARG_TOOLS=all
Environment=LLAMA_ARG_REASONING=on
Environment=LLAMA_ARG_THINK=auto
Environment=LLAMA_ARG_JINJA=on
# Sampling (temp/top_p/min_p env vars do not exist in b10884; effective
# values come from the model file: temp 1.0, top_p 0.95, top_k 20,
# min_p 0.05 server default)
Environment=LLAMA_ARG_TOP_K=20

[Service]
Restart=unless-stopped

[Install]
WantedBy=multi-user.target
